// thedonkey (mp-bioinfo): 20 threads, 188 GB RAM, no scheduler, shared with two colleagues.
// Caps sit ~25% below the machine totals because nothing else arbitrates between users.
// Database paths are pipeline parameters, so they live in thedonkey.yaml (-params-file).

workDir = "/media/shortterm/${System.getenv('USER')}/work"

process {
    executor       = 'local'
    resourceLimits = [ cpus: 15, memory: 141.GB, time: 48.h ]

    // nf-core label sizes brought closer to the JASEN per-tool settings
    withLabel:process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
    }
    withLabel:process_low {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_medium {
        cpus   = 4
        memory = { 4.GB * task.attempt }
    }
    withLabel:process_high {
        cpus   = 15
        memory = { 32.GB * task.attempt }
    }

    // Tools whose nf-core label is far from what JASEN gives them
    withName: 'SKESA' {
        cpus   = 15
        memory = { 32.GB * task.attempt }
    }
    withName: 'CHEWBBACA_ALLELECALL' {
        cpus   = 15
        memory = { 12.GB * task.attempt }
    }
    withName: 'GAMBITCORE' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
    }
    // The standard database needs ~80 GB; one job at a time keeps the rest of the box free
    withName: 'KRAKEN2_KRAKEN2' {
        memory   = { 100.GB * task.attempt }
        maxForks = 1
    }
}

executor {
    $local {
        cpus      = 15
        memory    = 141.GB
        queueSize = 8
    }
}

apptainer {
    cacheDir   = '/mnt/cache/singularity'
    runOptions = '--bind /mnt/cache/dbs'
}
