// thedonkey (mp-bioinfo): 20 threads, 188 GB RAM, no scheduler, shared with two colleagues.
// Caps sit ~25% below the machine totals because nothing else arbitrates between users.

params {
    db_root                 = '/mnt/cache/dbs'
    assets_dir              = "${db_root}"
    containers_dir          = '/mnt/cache/singularity'
    workDir                 = '/media/shortterm/ryan/work'
    outdir                  = '/media/Lagring/ryan/jasen'
    tracedir                = "${outdir}/pipeline_info"
    executor                = 'local'

    amrfinder_db            = "${db_root}/amrfinder_db/latest"
    emmtyper_db             = "${db_root}/emmtyper_db"
    gambit_db               = "${db_root}/gambit_db"
    hostile_dir             = "${db_root}/hostile_db"
    kraken_db               = "${db_root}/kraken2/standard_2025-06"
    mlst_blast_db           = "${db_root}/mlstdb/blast"
    plasmidfinder_db        = "${db_root}/plasmidfinder_db"
    pointfinder_db          = "${db_root}/pointfinder_db"
    pubmlst_db              = "${db_root}/mlstdb/pubmlst"
    resfinder_db            = "${db_root}/resfinder_db"
    serotypefinder_db       = "${db_root}/serotypefinder_db"
    virulencefinder_db      = "${db_root}/virulencefinder_db"
}

workDir = '/media/shortterm/ryan/work'

process {
    executor       = 'local'
    resourceLimits = [ cpus: 15, memory: 141.GB ]

    withName: kraken {
        maxForks = 1
    }
    withName: kraken_batch {
        maxForks = 1
    }
    withName: tbprofiler_mergedb {
        maxForks = 1
        ext.args = { "--external_db ${params.tbdb} --calling_params '-q 15'" }
    }
    // Upstream pins this at -t 40, which oversubscribes a 20-thread box.
    withName: medaka {
        ext.args = { "-t ${task.cpus} --bacteria" }
    }
}

executor {
    $local {
        cpus      = 15
        memory    = 141.GB
        queueSize = 8
    }
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/mnt/cache/singularity'
    runOptions = "--bind ${params.db_root} --bind ${params.containers_dir}"
}

// Re-declared here so the paths resolve against this file's outdir rather than
// the empty default baked in at parse time upstream.
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled   = true
    file      = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}
report {
    enabled   = true
    file      = "${params.tracedir}/execution_report_${trace_timestamp}.html"
    overwrite = true
}
trace {
    enabled   = true
    file      = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
    overwrite = true
}
dag {
    enabled   = true
    file      = "${params.tracedir}/pipeline_dag_${trace_timestamp}.html"
    overwrite = true
}
